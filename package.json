{
  "name": "@0123896/dsh-notify-sounds",
  "version": "1.0.0",
  "description": "DSH (DeepSeek Harness) plugin: play a distinct notification sound when the assistant finishes a reply, and another when the user needs to confirm / answer a question.",
  "license": "MIT",
  "author": "0123896",
  "homepage": "https://github.com/0123896/dsh-notify-sounds",
  "repository": {
    "type": "git",
    "url": "https://github.com/0123896/dsh-notify-sounds.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "notify",
    "audio",
    "sound",
    "beep"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
